<resources>
    <style name="AppDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/d_bg</item>
        <item name="android:colorBackground">@color/d_bg</item>
        <item name="android:statusBarColor">@color/d_bg</item>
        <item name="android:navigationBarColor">@color/d_bg</item>
        <item name="android:colorPrimary">@color/d_bg</item>
        <item name="android:colorAccent">@color/d_brand</item>
        <item name="android:colorControlActivated">@color/d_brand</item>
        <item name="android:textColorPrimary">@color/d_text</item>
        <item name="android:textColorSecondary">@color/d_muted</item>
        <item name="android:textColorHint">@color/d_muted</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog.Alert</item>
        <item name="cardColor">@color/d_card</item>
        <item name="chipColor">@color/d_chip</item>
        <item name="mutedText">@color/d_muted</item>
        <item name="mainText">@color/d_text</item>
        <item name="brand">@color/d_brand</item>
        <item name="warnColor">@color/d_warn</item>
    </style>

    <style name="AppLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/l_bg</item>
        <item name="android:colorBackground">@color/l_bg</item>
        <item name="android:statusBarColor">@color/l_bg</item>
        <item name="android:navigationBarColor">@color/l_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/l_bg</item>
        <item name="android:colorAccent">@color/l_brand</item>
        <item name="android:colorControlActivated">@color/l_brand</item>
        <item name="android:textColorPrimary">@color/l_text</item>
        <item name="android:textColorSecondary">@color/l_muted</item>
        <item name="android:textColorHint">@color/l_muted</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Light.Dialog.Alert</item>
        <item name="cardColor">@color/l_card</item>
        <item name="chipColor">@color/l_chip</item>
        <item name="mutedText">@color/l_muted</item>
        <item name="mainText">@color/l_text</item>
        <item name="brand">@color/l_brand</item>
        <item name="warnColor">@color/l_warn</item>
    </style>
</resources>
